  html, body { width: 100mm; height: 180mm; overflow: hidden; background: #fff; color: #000; }
  body { position: relative; font-family: "Microsoft YaHei", "PingFang SC", "SimHei", sans-serif; }
  .cell, .rule, .ink { position: absolute; }
  .cell { overflow: hidden; }
  .rule { background: #000; }
  .rule--dashed-h { background: repeating-linear-gradient(90deg, #000 0 1.2mm, transparent 1.2mm 2mm); }
  .rule--dashed-v { background: repeating-linear-gradient(180deg, #000 0 1.2mm, transparent 1.2mm 2mm); }
  .ink { inset: 0.4mm; background: #000; }
